{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["books", "home", "electronics", "clothing"]
    },
    "priceMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inventory": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["active", "discontinued"]
    },
    "popularityWeight": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "sku",
    "name",
    "category",
    "priceMinor",
    "inventory",
    "status",
    "popularityWeight"
  ],
  "additionalProperties": false
}
