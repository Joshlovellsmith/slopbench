{
  "name": "slopbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "slopbench": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "round0:test": "bun benchmark/scripts/public.ts",
    "round0:fixtures": "bun benchmark/scripts/fixtures.ts",
    "round0:generate-openapi": "bun benchmark/scripts/generate-openapi.ts",
    "round0:traceability": "bun benchmark/scripts/check-contract.ts --write",
    "round0:check": "bun benchmark/scripts/generate-openapi.ts --check && bun benchmark/scripts/check-contract.ts && redocly lint --config benchmark/spec/redocly.yaml benchmark/spec/openapi.yaml && python3 benchmark/scripts/verify-vectors.py && bun run round0:verify-freeze",
    "round0:reference-test": "bun benchmark/scripts/reference.ts",
    "round0:verify-freeze": "bun benchmark/scripts/freeze.ts"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@redocly/cli": "2.72.0",
    "@types/bun": "1.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
